{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "TeamStrandsGatewayMemory",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "TeamStrandsGatewayMemory"
  },
  "runtimes": [
    {
      "name": "ai_gk_gwmem_agent",
      "build": "CodeZip",
      "entrypoint": "src/main.py",
      "codeLocation": "ai-gk/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    },
    {
      "name": "ai_def_gwmem_agent",
      "build": "CodeZip",
      "entrypoint": "src/main.py",
      "codeLocation": "ai-def/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    },
    {
      "name": "ai_mid_gwmem_agent",
      "build": "CodeZip",
      "entrypoint": "src/main.py",
      "codeLocation": "ai-mid/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    },
    {
      "name": "ai_fwd1_gwmem_agent",
      "build": "CodeZip",
      "entrypoint": "src/main.py",
      "codeLocation": "ai-fwd1/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    },
    {
      "name": "ai_fwd2_gwmem_agent",
      "build": "CodeZip",
      "entrypoint": "src/main.py",
      "codeLocation": "ai-fwd2/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "team_memory",
      "eventExpiryDuration": 7
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "tactical-tools",
      "description": "Tactical analysis MCP tools for the AI football team",
      "authorizerType": "NONE",
      "protocolType": "MCP",
      "targets": [
        {
          "name": "calculate-pass-options",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "calculate_pass_options",
              "description": "Calculate pass success probability for each teammate based on distance and interception risk. Build the inputs from the positions in your state summary.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "passer_position": {
                    "type": "object",
                    "description": "Your current position",
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" }
                    },
                    "required": ["x", "y"]
                  },
                  "teammates": {
                    "type": "array",
                    "description": "Your teammates from the Teammates list (id and position)",
                    "items": {
                      "type": "object",
                      "properties": {
                        "player_id": { "type": "integer" },
                        "position": {
                          "type": "object",
                          "properties": {
                            "x": { "type": "number" },
                            "y": { "type": "number" }
                          },
                          "required": ["x", "y"]
                        }
                      },
                      "required": ["player_id", "position"]
                    }
                  },
                  "opponents": {
                    "type": "array",
                    "description": "Opponent players from the Opponents list",
                    "items": {
                      "type": "object",
                      "properties": {
                        "position": {
                          "type": "object",
                          "properties": {
                            "x": { "type": "number" },
                            "y": { "type": "number" }
                          },
                          "required": ["x", "y"]
                        }
                      },
                      "required": ["position"]
                    }
                  }
                },
                "required": [
                  "passer_position",
                  "teammates",
                  "opponents"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "pythonVersion": "PYTHON_3_12",
            "implementation": {
              "language": "Python",
              "path": "gateway_tools/",
              "handler": "calculate_pass_options.lambda_handler"
            },
            "timeout": 30,
            "memorySize": 512
          }
        },
        {
          "name": "evaluate-shot",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "evaluate_shot",
              "description": "Evaluate shot success probability from your position and recommend aim point and power. Returns should_shoot, recommended_aim, recommended_power.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "shooter_position": {
                    "type": "object",
                    "description": "Your current position",
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" }
                    },
                    "required": ["x", "y"]
                  },
                  "goalkeeper_position": {
                    "type": "object",
                    "description": "The OPPONENT goalkeeper's position (usually OPP0)",
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" }
                    },
                    "required": ["x", "y"]
                  },
                  "team_side": {
                    "type": "string",
                    "enum": ["HOME", "AWAY"],
                    "description": "Your team side: HOME if your goal is at x=-55, AWAY if your goal is at x=+55"
                  },
                  "blocker_positions": {
                    "type": "array",
                    "description": "Positions of opponents between you and the goal (optional)",
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": { "type": "number" },
                        "y": { "type": "number" }
                      },
                      "required": ["x", "y"]
                    }
                  }
                },
                "required": [
                  "shooter_position",
                  "goalkeeper_position",
                  "team_side"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "pythonVersion": "PYTHON_3_12",
            "implementation": {
              "language": "Python",
              "path": "gateway_tools/",
              "handler": "evaluate_shot.lambda_handler"
            },
            "timeout": 30,
            "memorySize": 512
          }
        },
        {
          "name": "find-open-space",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "find_open_space",
              "description": "Grid-based open space finder by zone (attack/midfield/defense). Returns recommended_position to MOVE_TO.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "opponent_positions": {
                    "type": "array",
                    "description": "Positions of all opponent players from the Opponents list",
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": { "type": "number" },
                        "y": { "type": "number" }
                      },
                      "required": ["x", "y"]
                    }
                  },
                  "zone": {
                    "type": "string",
                    "enum": ["attack", "midfield", "defense"],
                    "description": "Zone to find space in, relative to your team's attacking direction"
                  },
                  "team_side": {
                    "type": "string",
                    "enum": ["HOME", "AWAY"],
                    "description": "Your team side: HOME if your goal is at x=-55, AWAY if your goal is at x=+55"
                  },
                  "my_position": {
                    "type": "object",
                    "description": "Your current position",
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" }
                    },
                    "required": ["x", "y"]
                  }
                },
                "required": [
                  "opponent_positions",
                  "zone",
                  "team_side",
                  "my_position"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "pythonVersion": "PYTHON_3_12",
            "implementation": {
              "language": "Python",
              "path": "gateway_tools/",
              "handler": "find_open_space.lambda_handler"
            },
            "timeout": 30,
            "memorySize": 512
          }
        },
        {
          "name": "get-defensive-assignment",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "get_defensive_assignment",
              "description": "Rank opponent threats and recommend who to MARK and how tightly. Returns recommended_mark with player_id and recommended_tightness.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "opponents": {
                    "type": "array",
                    "description": "Opponent players from the Opponents list (id and position)",
                    "items": {
                      "type": "object",
                      "properties": {
                        "player_id": { "type": "integer" },
                        "position": {
                          "type": "object",
                          "properties": {
                            "x": { "type": "number" },
                            "y": { "type": "number" }
                          },
                          "required": ["x", "y"]
                        }
                      },
                      "required": ["player_id", "position"]
                    }
                  },
                  "ball": {
                    "type": "object",
                    "description": "Ball position, plus possession_player_id if an opponent holds it",
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" },
                      "possession_player_id": { "type": "integer" }
                    },
                    "required": ["x", "y"]
                  },
                  "my_position": {
                    "type": "object",
                    "description": "Your current position",
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" }
                    },
                    "required": ["x", "y"]
                  },
                  "team_side": {
                    "type": "string",
                    "enum": ["HOME", "AWAY"],
                    "description": "Your team side: HOME if your goal is at x=-55, AWAY if your goal is at x=+55"
                  }
                },
                "required": [
                  "opponents",
                  "ball",
                  "my_position",
                  "team_side"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "pythonVersion": "PYTHON_3_12",
            "implementation": {
              "language": "Python",
              "path": "gateway_tools/",
              "handler": "get_defensive_assignment.lambda_handler"
            },
            "timeout": 30,
            "memorySize": 512
          }
        }
      ]
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
